{
  "name": "verify-package-deps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check-fmt": "oxfmt --check .",
    "check-format": "oxfmt --check .",
    "check-types": "tsc",
    "fmt": "oxfmt .",
    "format": "oxfmt .",
    "lint": "oxlint --quiet --config ../../oxlint.config.ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "verify": "node src/verify-package-deps.ts",
    "verify:fix": "node src/verify-package-deps.ts --fix"
  },
  "dependencies": {
    "oxc-parser": "^0.129.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "oxfmt": "^0.45.0",
    "typescript": "~6.0.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.11.0"
}
